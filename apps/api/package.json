{
  "name": "api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "dev": "nest start --watch --exec \"node --env-file-if-exists=../../.env\"",
    "check-types": "tsc --noEmit",
    "start": "nest start --exec \"node --env-file-if-exists=../../.env\"",
    "start:dev": "nest start --watch --exec \"node --env-file-if-exists=../../.env\"",
    "start:debug": "nest start --debug --watch --exec \"node --env-file-if-exists=../../.env\"",
    "start:prod": "node dist/main",
    "lint": "oxlint src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "seed": "node --env-file=../../.env dist/seed/run.js",
    "email:test": "node --env-file=../../.env dist/email/send-test-email.js"
  },
  "dependencies": {
    "@better-auth/core": "1.7.4",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@repo/contracts": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/domain": "workspace:*",
    "@repo/notifications": "workspace:*",
    "@thallesp/nestjs-better-auth": "2.8.0",
    "better-auth": "1.7.4",
    "express": "^5.2.1",
    "nestjs-pino": "5.1.0",
    "pg-boss": "12.32.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@prisma/adapter-pg": "7.10.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "dotenv": "^17.4.2",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2"
  }
}
