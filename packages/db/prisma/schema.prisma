// Rasi — Prisma schema.
//
// packages/db is the sole owner of the schema (system-architecture.md).
//
// Order matters here. Better Auth's models (User, Session, Account,
// Verification) are written into this file by `npx @better-auth/cli generate`
// and MUST land before the Rasi models, because staff_profile.userId is a
// foreign key to user.id (data-dictionary.md) and Prisma requires both sides
// of every relation. The Rasi schema cannot pass `prisma validate` until
// model User exists.
//
// The generated Better Auth models are never hand-edited except to add
// back-relation fields (staffProfile, notifications, pushSubscriptions,
// notificationPreferences, emails).
// Never add scalar columns to them — `generate` has to stay re-runnable
// across Better Auth upgrades. See packages/db/README.md.
//
// Conventions, applied without exception (erd.md, data-dictionary.md):
//   - Models are PascalCase, tables snake_case via @@map, columns camelCase.
//   - Primary keys are cuid() text. The one exception is idempotency_key,
//     whose PK is the client-supplied UUID itself.
//   - Money is Decimal @db.Decimal(14,2). Never Float, anywhere, ever (BR-11).
//   - Business dates are @db.Date; instants are @db.Timestamptz(3). Prisma's
//     default for DateTime is timestamp WITHOUT time zone, so the annotation
//     is required rather than decorative — ADR-0009 depends on it.
//   - Every foreign key carries an index; Postgres does not create one.
//
// Invariants live in the database (coding-guidelines.md#database). Partial
// unique indexes are declared here through the `partialIndexes` preview, so
// Prisma manages them and `migrate dev` does not see them as drift. CHECK
// constraints and triggers cannot be expressed in this file; they live in the
// `constraints_*` migrations, and Prisma neither diffs nor drops them. Each
// model below names the constraints that guard it.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated"
  moduleFormat    = "esm"
  runtime         = "nodejs"
  previewFeatures = ["partialIndexes"]
}

// Prisma 7 removed `url` from the datasource block. The migration connection
// string lives in prisma7.config.ts; the runtime client takes a driver adapter.

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Better Auth — generated. Hand-edits limited to the three back-relations.
// ---------------------------------------------------------------------------

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  // Back-relations added by hand. Prisma requires both sides of a relation,
  // so these cannot be omitted. Relation fields only — never scalar columns.
  staffProfile            StaffProfile?
  notifications           Notification[]
  pushSubscriptions       PushSubscription[]
  notificationPreferences NotificationPreference[]
  emails                  EmailOutbox[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum StaffRole {
  SUPER_ADMIN
  ADMIN
  SENIOR
  JUNIOR
}

enum StaffStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum AssignmentRole {
  SENIOR
  JUNIOR
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  BLACKLISTED
}

enum AccountStatus {
  PENDING
  ACTIVE
  COMPLETED
  DEFAULTED
  WRITTEN_OFF
}

enum ScheduleStatus {
  PENDING
  COLLECTED
  PARTIAL
  MISSED
  CANCELLED
}

enum Classification {
  CORRECT
  LOW
  EXTRA
  NO_PAYMENT
}

enum EntryType {
  ORIGINAL
  ADJUSTMENT
}

enum CollectionStatus {
  PENDING_APPROVAL
  CONFIRMED
  REVERSED
  /// A correction the approver refused: never applied, still in history (US-044).
  REJECTED
}

enum ApprovalDecision {
  PENDING
  APPROVED
  REJECTED
}

enum DayCloseStatus {
  OPEN
  CLOSED
  REOPENED
  TALLIED
}

enum HandoverStatus {
  PENDING
  ACKNOWLEDGED
  DISPUTED
}

/// BR-17: cash moves in two hops. The office hop lands in CASH_AT_OFFICE.
enum HandoverHop {
  JUNIOR_TO_SENIOR
  SENIOR_TO_OFFICE
}

enum LedgerAccountType {
  CASH_IN_HAND
  CASH_AT_OFFICE
  LOAN_RECEIVABLE
  CAPITAL
  UNEARNED_PROFIT
  EARNED_PROFIT
  /// What a written-off account cost the business (US-035). Debit-normal,
  /// like the expense it is. Added 2026-09-20.
  WRITE_OFF_LOSS
}

enum Direction {
  DEBIT
  CREDIT
}

enum LedgerTransactionType {
  DISBURSEMENT
  COLLECTION
  HANDOVER
  ADJUSTMENT
  WRITE_OFF
}

enum NotificationCategory {
  INFORMATION
  SUCCESS
  WARNING
  ALERT
}

enum NotificationEvent {
  NEW_ASSIGNMENT
  LOW_COLLECTION
  EXTRA_COLLECTION
  MISSED_COLLECTION
  ACCOUNT_COMPLETED
  DAY_CLOSE_DISCREPANCY
  APPROVAL_REQUESTED
  /// Added 2026-09-14 for events shipped since M10 was specified.
  NO_PAYMENT_COLLECTION
  HANDOVER_SUBMITTED
  HANDOVER_DISPUTED
  DAY_REOPENED
  RECONCILIATION_MISMATCH
  /// Added 2026-09-17 for US-093 (migration holiday_events).
  HOLIDAY_DECLARED
  HOLIDAY_REMOVED
  /// Added 2026-09-20 (migration customer_handover_events): the two M10
  /// catalogued events nothing raised — US-020 and US-062.
  NEW_CUSTOMER
  HANDOVER_ACKNOWLEDGED
  /// Added 2026-09-20 (migration account_overdue_event): BR-05 overdue, to
  /// the line's Senior as a WARNING.
  ACCOUNT_OVERDUE
}

enum PushProvider {
  WEB_PUSH
  FCM
}

enum OutboxStatus {
  PENDING
  SENT
  FAILED
  EXPIRED
}

/// What an email is for (notifications.md#email).
enum EmailKind {
  /// A copy of an in-app notification; points at it.
  NOTIFICATION
  /// Sent to an organization's owner on sign-up (US-006).
  WELCOME
  /// The link that starts a self-service password reset (US-003). Added
  /// 2026-09-20 (migration password_reset_email).
  PASSWORD_RESET
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  LOGIN
  REOPEN_DAY
  /// A report, dashboard or list downloaded as Excel or PDF (M12). Nothing
  /// changed: the entry records that business figures left the system.
  EXPORT
}

/// Why a security-relevant attempt was refused (M13, `security_event`).
enum SecurityEventKind {
  /// The caller's role does not hold the route's permission (`PolicyGuard`).
  PERMISSION_DENIED
  /// A role tried to create or act on one senior to its own (M01 rule 1).
  RANK_GUARD
  /// Someone tried to change their own role or their own status (M01 rule 2).
  SELF_GUARD
  /// A setting that is immutable, or locked once the business has accounts (M15).
  SETTING_LOCKED
  /// An administration id that is missing, or belongs to another organization (M02).
  OUT_OF_SCOPE
}

// ---------------------------------------------------------------------------
// Identity and organisation
// ---------------------------------------------------------------------------

/// One per business, created by organization sign-up (ADR-0012). Business
/// codes, settings and holidays are unique within an organization.
model Organization {
  id        String   @id @default(cuid())
  name      String
  /// Public identity in the sign-in link, generated from the name by sign-up.
  /// CHECK organization_slug_format_check (migration constraints_organization_slug).
  slug      String   @unique @default(dbgenerated("('org-'::text || substr(md5((random())::text), 1, 12))"))
  timezone  String
  currency  String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  sectors        Sector[]
  lines          Line[]
  customers      Customer[]
  accountLoans   AccountLoan[]
  staffProfiles  StaffProfile[]
  holidays       Holiday[]
  settings       Setting[]
  ledgerAccounts LedgerAccount[]
  auditLogs      AuditLog[]
  securityEvents SecurityEvent[]
  emails         EmailOutbox[]

  @@map("organization")
}

model StaffProfile {
  id                 String      @id @default(cuid())
  organizationId     String
  userId             String      @unique
  staffCode          String      @unique
  role               StaffRole
  phone              String      @unique
  status             StaffStatus @default(ACTIVE)
  /// Set by an Admin password reset (US-003); cleared when the staff member
  /// changes their password. While set, only the password change is allowed.
  mustChangePassword Boolean     @default(false)
  joinedAt           DateTime    @db.Date
  /// Soft delete. Excluded from every query when set.
  deletedAt          DateTime?   @db.Timestamptz(3)

  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)
  createdByUserId String?

  organization Organization      @relation(fields: [organizationId], references: [id])
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments  LineAssignment[]
  syncReport   DeviceSyncReport?

  @@index([organizationId])
  @@index([status])
  @@map("staff_profile")
}

model Sector {
  id             String  @id @default(cuid())
  organizationId String
  /// Unique within the organization (ADR-0012).
  code           String
  name           String
  /// Inactive sectors keep history and accept no new lines.
  isActive       Boolean @default(true)

  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)
  createdByUserId String?

  organization Organization @relation(fields: [organizationId], references: [id])
  lines        Line[]
  customers    Customer[]
  holidays     Holiday[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("sector")
}

model Line {
  id             String  @id @default(cuid())
  organizationId String
  sectorId       String
  /// Unique across the organization, not per sector (LN-07, ADR-0012).
  code           String
  name           String
  isActive       Boolean @default(true)

  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)
  createdByUserId String?

  organization        Organization         @relation(fields: [organizationId], references: [id])
  sector              Sector               @relation(fields: [sectorId], references: [id])
  assignments         LineAssignment[]
  customers           Customer[]
  customerLinePeriods CustomerLinePeriod[]
  accountLoans        AccountLoan[]
  collections         Collection[]
  dayCloses           DayClose[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([sectorId])
  @@map("line")
}

/// Temporal staffing record. Who worked which line, and when (BR-15).
/// CHECK: effectiveTo >= effectiveFrom (migration constraints_line_assignment).
model LineAssignment {
  id             String         @id @default(cuid())
  lineId         String
  staffProfileId String
  assignmentRole AssignmentRole
  effectiveFrom  DateTime       @db.Date
  /// NULL means this is the current assignment.
  effectiveTo    DateTime?      @db.Date
  reason         String?

  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)
  createdByUserId String?

  line         Line         @relation(fields: [lineId], references: [id])
  staffProfile StaffProfile @relation(fields: [staffProfileId], references: [id])

  // One current Senior per line.
  @@unique([lineId], map: "line_assignment_current_senior_key", where: raw("(\"assignmentRole\" = 'SENIOR'::\"AssignmentRole\") AND (\"effectiveTo\" IS NULL)"))
  // A staff member works one line at a time.
  @@unique([staffProfileId], map: "line_assignment_current_staff_key", where: raw("(\"effectiveTo\" IS NULL)"))
  // Serves the current-staffing lookup (erd.md).
  @@index([lineId, effectiveTo])
  @@index([staffProfileId])
  @@map("line_assignment")
}

// ---------------------------------------------------------------------------
// Customers and accounts
// ---------------------------------------------------------------------------

model Customer {
  id              String         @id @default(cuid())
  organizationId  String
  customerCode    String         @unique
  name            String
  /// E.164. Indexed but NOT unique — family members share numbers.
  mobile          String
  alternateMobile String?
  address         String
  /// Denormalised from line for query convenience.
  sectorId        String
  /// Current line. Historical attribution lives on collection (BR-15).
  lineId          String
  /// Place on the line's visiting order (US-040), set by the line's Senior or
  /// an Admin. Null: not yet placed — such customers come after the placed
  /// ones, in customer-code order. Cleared when the customer changes line.
  /// CHECK: routePosition >= 1 (migration constraints_customer_route_position).
  routePosition   Int?
  status          CustomerStatus @default(ACTIVE)
  notes           String?
  /// Soft delete. Blocked while any ACTIVE account exists.
  deletedAt       DateTime?      @db.Timestamptz(3)

  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)
  createdByUserId String?

  organization Organization         @relation(fields: [organizationId], references: [id])
  sector       Sector               @relation(fields: [sectorId], references: [id])
  line         Line                 @relation(fields: [lineId], references: [id])
  references   CustomerReference[]
  accountLoans AccountLoan[]
  linePeriods  CustomerLinePeriod[]

  @@index([organizationId])
  @@index([sectorId])
  @@index([lineId])
  @@index([mobile])
  /// One customer per place on a line's visiting order.
  @@unique([lineId, routePosition], map: "customer_line_route_position_key", where: raw("(\"routePosition\" IS NOT NULL)"))
  @@map("customer")
}

/// Which line a customer belonged to, and when (US-023). The open row — the
/// one with no effectiveTo — is the current line, mirrored on customer.lineId.
///
/// It exists so a collection taken offline can still be synced by the Junior
/// who took it after the customer has moved on: the check is "was this
/// customer on my line on that collection's business date", not "is it now".
/// On the transfer day both periods cover the date, so both lines' Juniors
/// may sync that day's collection — either one really could have taken it.
/// Attribution is still frozen on the collection itself (BR-15).
///
/// CHECK: effectiveTo >= effectiveFrom (migration constraints_customer_line_period).
model CustomerLinePeriod {
  id            String    @id @default(cuid())
  customerId    String
  lineId        String
  effectiveFrom DateTime  @db.Date
  /// NULL means this is the current line.
  effectiveTo   DateTime? @db.Date
  reason        String?

  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)
  createdByUserId String?

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  line     Line     @relation(fields: [lineId], references: [id])

  // One current line per customer.
  @@unique([customerId], map: "customer_line_period_current_key", where: raw("(\"effectiveTo\" IS NULL)"))
  // Serves "who was on my line on this date" from the collection path.
  @@index([lineId, effectiveFrom])
  @@index([customerId, effectiveFrom])
  @@map("customer_line_period")
}

model CustomerReference {
  id         String  @id @default(cuid())
  customerId String
  name       String
  mobile     String
  /// Free text — "brother", "shop owner opposite".
  relation   String?
  address    String?

  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)
  createdByUserId String?

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_reference")
}

/// The loan. Called "Account" in every piece of user-facing text; named
/// AccountLoan here because Better Auth owns the model name Account.
model AccountLoan {
  id             String @id @default(cuid())
  organizationId String
  accountCode    String @unique
  customerId     String
  /// Line at creation.
  lineId         String

  /// A — immutable after disbursement.
  accountAmount  Decimal @db.Decimal(14, 2)
  /// I — immutable after disbursement.
  investedAmount Decimal @db.Decimal(14, 2)
  /// P — derived (BR-01). A check constraint enforces P = A - I.
  profitAmount   Decimal @db.Decimal(14, 2)
  /// D
  dailyAmount    Decimal @db.Decimal(14, 2)
  /// N
  termDays       Int     @default(100)

  /// Day 0, and not itself a collection day (BR-03).
  disbursementDate     DateTime  @db.Date
  /// The next working day after disbursement.
  firstCollectionDate  DateTime  @db.Date
  /// Recomputed after every collection (BR-06).
  targetCompletionDate DateTime  @db.Date
  actualCompletionDate DateTime? @db.Date

  /// Denormalised cache, reconciled nightly.
  collectedAmount   Decimal       @default(0) @db.Decimal(14, 2)
  /// Cache of A - collected. Initialised to accountAmount at creation.
  outstandingAmount Decimal       @db.Decimal(14, 2)
  status            AccountStatus @default(PENDING)
  /// A flag on ACTIVE, not a status of its own (BR-05). Set by a scheduled job.
  isOverdue         Boolean       @default(false)
  /// Required for DEFAULTED and WRITTEN_OFF.
  closureNote       String?

  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)
  createdByUserId String?

  organization   Organization      @relation(fields: [organizationId], references: [id])
  customer       Customer          @relation(fields: [customerId], references: [id])
  line           Line              @relation(fields: [lineId], references: [id])
  schedules      AccountSchedule[]
  collections    Collection[]
  ledgerAccounts LedgerAccount[]

  @@index([organizationId])
  @@index([customerId])
  // Line dashboards, and the OVERDUE flagging job (erd.md).
  @@index([lineId, status])
  @@index([status, targetCompletionDate])
  @@map("account_loan")
}

/// The plan. Regenerable tail, immutable head (BR-04, BR-06).
model AccountSchedule {
  id             String         @id @default(cuid())
  accountLoanId  String
  /// 1-based, unique within the account.
  sequence       Int
  /// Always a working day (BR-02).
  dueDate        DateTime       @db.Date
  /// min(D, outstanding at generation) — BR-07.
  expectedAmount Decimal        @db.Decimal(14, 2)
  status         ScheduleStatus @default(PENDING)

  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)
  createdByUserId String?

  accountLoan AccountLoan  @relation(fields: [accountLoanId], references: [id], onDelete: Cascade)
  collections Collection[]

  @@unique([accountLoanId, sequence])
  // Today's expected across the business, and the MISSED detection job.
  @@index([dueDate, status])
  @@map("account_schedule")
}

// ---------------------------------------------------------------------------
// Collections and cash
// ---------------------------------------------------------------------------

/// Append-only. There is no update or delete path in the API — a correction
/// inserts an ADJUSTMENT row instead (BR-14).
model Collection {
  id String @id @default(cuid())

  /// Client-generated UUID v4, created at record time. The unique constraint
  /// IS the replay-safety mechanism for offline sync (BR-13).
  idempotencyKey String @unique

  /// Mandatory and never inferred — a customer may hold several concurrent
  /// accounts (BR-01a).
  accountLoanId     String
  /// Null for adjustments.
  accountScheduleId String?
  /// Frozen at write (BR-15). Not read from the customer's current line.
  lineId            String
  /// Frozen at write. Who physically collected the money.
  collectedByUserId String

  /// Asia/Kolkata, computed once at write (BR-12).
  businessDate DateTime @db.Date
  /// Device clock at recording. May precede syncedAt by hours when offline.
  capturedAt   DateTime @db.Timestamptz(3)
  /// Server receipt. Equals capturedAt when the device was online.
  syncedAt     DateTime @db.Timestamptz(3)

  /// Snapshot. Not recomputable later, because the schedule may have moved.
  expectedAmount Decimal @db.Decimal(14, 2)
  /// 0 is valid (NO_PAYMENT); negative only on an ADJUSTMENT.
  amount         Decimal @db.Decimal(14, 2)
  /// amount - expectedAmount.
  variance       Decimal @db.Decimal(14, 2)

  classification      Classification
  entryType           EntryType        @default(ORIGINAL)
  /// Self-reference. Required when entryType = ADJUSTMENT.
  adjustsCollectionId String?
  status              CollectionStatus @default(CONFIRMED)
  note                String?

  /// No updatedAt: nothing updates. Status transitions are the sole
  /// exception and are themselves audited (data-dictionary.md).
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  createdByUserId String?

  accountLoan     AccountLoan         @relation(fields: [accountLoanId], references: [id])
  accountSchedule AccountSchedule?    @relation(fields: [accountScheduleId], references: [id])
  line            Line                @relation(fields: [lineId], references: [id])
  adjusts         Collection?         @relation("CollectionAdjustment", fields: [adjustsCollectionId], references: [id])
  adjustedBy      Collection[]        @relation("CollectionAdjustment")
  approval        CollectionApproval?

  /// One correction at a time per collection (US-044): a second request while
  /// one waits would be decided against a balance the first may change.
  @@unique([adjustsCollectionId], map: "collection_one_pending_correction_key", where: raw("(\"status\" = 'PENDING_APPROVAL'::\"CollectionStatus\")"))
  // Daily line tally and day close; account history; per-Junior cash
  // reconciliation (erd.md).
  @@index([lineId, businessDate])
  @@index([accountLoanId, businessDate])
  @@index([collectedByUserId, businessDate])
  @@index([accountScheduleId])
  @@index([adjustsCollectionId])
  @@map("collection")
}

model CollectionApproval {
  id                String           @id @default(cuid())
  collectionId      String           @unique
  requestedByUserId String
  /// A Senior on their own line, or an Admin.
  decidedByUserId   String?
  decision          ApprovalDecision @default(PENDING)
  /// Required from the requester.
  reason            String
  decisionNote      String?
  decidedAt         DateTime?        @db.Timestamptz(3)

  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)
  createdByUserId String?

  collection Collection @relation(fields: [collectionId], references: [id])

  @@index([decision])
  @@map("collection_approval")
}

model DayClose {
  id           String   @id @default(cuid())
  lineId       String
  businessDate DateTime @db.Date

  /// Σ expected for slots due that date (BR-16).
  expectedTotal     Decimal @db.Decimal(14, 2)
  /// Σ confirmed collections.
  collectedTotal    Decimal @db.Decimal(14, 2)
  /// Σ acknowledged handovers.
  cashReceivedTotal Decimal @db.Decimal(14, 2)
  /// cashReceivedTotal - collectedTotal.
  discrepancy       Decimal @db.Decimal(14, 2)

  /// TALLIED is CLOSED with discrepancy = 0 and every handover acknowledged.
  status         DayCloseStatus @default(OPEN)
  closedByUserId String?
  closedAt       DateTime?      @db.Timestamptz(3)
  /// Required for a manual reopen. Null when a late offline sync reopened the
  /// day automatically (BR-16a), which is audited with the system as actor.
  reopenReason   String?

  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)
  createdByUserId String?

  line      Line           @relation(fields: [lineId], references: [id])
  handovers CashHandover[]

  @@unique([lineId, businessDate])
  @@map("day_close")
}

model CashHandover {
  id         String      @id @default(cuid())
  dayCloseId String
  /// A Junior, or a Senior on the second hop.
  fromUserId String
  /// A Senior, or an Admin.
  toUserId   String
  hop        HandoverHop

  /// Physically counted.
  declaredAmount Decimal @db.Decimal(14, 2)
  /// What Rasi recorded for that person and date.
  systemAmount   Decimal @db.Decimal(14, 2)
  /// declaredAmount - systemAmount.
  discrepancy    Decimal @db.Decimal(14, 2)

  /// The sender's explanation; required when the count differs from the system (S-06).
  note           String?
  status         HandoverStatus @default(PENDING)
  /// Cash has not moved until this is set (BR-17).
  acknowledgedAt DateTime?      @db.Timestamptz(3)
  disputeNote    String?

  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)
  createdByUserId String?

  dayClose      DayClose           @relation(fields: [dayCloseId], references: [id])
  denominations CashDenomination[]

  /// One handover waiting at a time per sender and day: a second count while
  /// the first is unanswered would be reconciled against a moving figure.
  @@unique([dayCloseId, fromUserId], map: "cash_handover_one_pending_key", where: raw("(\"status\" = 'PENDING'::\"HandoverStatus\")"))
  @@index([dayCloseId])
  @@index([fromUserId])
  @@index([toUserId])
  @@map("cash_handover")
}

/// What a Junior's phone last said about its outbox (US-060: S-05 names Juniors
/// who have not synced). One row per staff member, replaced on each report;
/// the server cannot see a phone's queue any other way.
model DeviceSyncReport {
  id             String    @id @default(cuid())
  staffProfileId String    @unique
  /// Collections saved on the phone and not yet acknowledged by the server.
  unsentCount    Int
  /// capturedAt of the oldest of them.
  oldestUnsentAt DateTime? @db.Timestamptz(3)
  reportedAt     DateTime  @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  staffProfile StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)

  @@map("device_sync_report")
}

model CashDenomination {
  id             String  @id @default(cuid())
  cashHandoverId String
  /// 500 | 200 | 100 | 50 | 20 | 10 | 5 | 2 | 1
  denomination   Int
  count          Int
  /// denomination × count. Σ subtotal must equal the handover's declaredAmount.
  subtotal       Decimal @db.Decimal(14, 2)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  cashHandover CashHandover @relation(fields: [cashHandoverId], references: [id], onDelete: Cascade)

  @@unique([cashHandoverId, denomination])
  @@map("cash_denomination")
}

// ---------------------------------------------------------------------------
// Ledger — append-only (ADR-0006)
// ---------------------------------------------------------------------------

/// One CASH_IN_HAND per staff member, one LOAN_RECEIVABLE per account, both
/// created automatically. CHECKs tie ownerUserId / accountLoanId to the type
/// and normalBalance to the account's nature (migration constraints_ledger).
///
/// Unlike ledger_transaction and ledger_entry this table is NOT append-only:
/// `balance` is a cache rebuilt by the nightly reconciliation job.
model LedgerAccount {
  id             String            @id @default(cuid())
  /// Every ledger account belongs to one organization; the business-wide
  /// types (CASH_AT_OFFICE, CAPITAL, UNEARNED_PROFIT, EARNED_PROFIT) exist once
  /// per organization (decided 2026-09-13).
  organizationId String
  accountType    LedgerAccountType
  /// Required for CASH_IN_HAND.
  ownerUserId    String?
  /// Required for LOAN_RECEIVABLE.
  accountLoanId  String?
  normalBalance  Direction
  /// Cache. Rebuilt and verified by the nightly reconciliation job.
  balance        Decimal           @default(0) @db.Decimal(14, 2)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  organization Organization  @relation(fields: [organizationId], references: [id])
  accountLoan  AccountLoan?  @relation(fields: [accountLoanId], references: [id])
  entries      LedgerEntry[]

  @@unique([ownerUserId], map: "ledger_account_cash_in_hand_owner_key", where: raw("(\"accountType\" = 'CASH_IN_HAND'::\"LedgerAccountType\")"))
  @@unique([organizationId, accountType], map: "ledger_account_organization_singleton_key", where: raw("(\"accountType\" = ANY (ARRAY['CASH_AT_OFFICE'::\"LedgerAccountType\", 'CAPITAL'::\"LedgerAccountType\", 'UNEARNED_PROFIT'::\"LedgerAccountType\", 'EARNED_PROFIT'::\"LedgerAccountType\", 'WRITE_OFF_LOSS'::\"LedgerAccountType\"]))"))
  @@unique([accountLoanId], map: "ledger_account_loan_receivable_key", where: raw("(\"accountType\" = 'LOAN_RECEIVABLE'::\"LedgerAccountType\")"))
  @@index([organizationId])
  @@index([accountType])
  @@index([ownerUserId])
  @@index([accountLoanId])
  @@map("ledger_account")
}

model LedgerTransaction {
  id              String                @id @default(cuid())
  transactionType LedgerTransactionType
  /// Polymorphic reference, deliberately without a foreign key (erd.md §4).
  sourceTable     String
  sourceId        String
  businessDate    DateTime              @db.Date
  /// When the event occurred, not when it was recorded.
  eventAt         DateTime              @db.Timestamptz(3)
  description     String

  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  createdByUserId String?

  entries LedgerEntry[]

  @@index([businessDate])
  @@index([sourceTable, sourceId])
  @@map("ledger_transaction")
}

model LedgerEntry {
  id                  String    @id @default(cuid())
  ledgerTransactionId String
  ledgerAccountId     String
  direction           Direction
  /// Always positive. The direction carries the sign.
  amount              Decimal   @db.Decimal(14, 2)
  /// Ordering within the transaction.
  sequence            Int

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  ledgerTransaction LedgerTransaction @relation(fields: [ledgerTransactionId], references: [id])
  ledgerAccount     LedgerAccount     @relation(fields: [ledgerAccountId], references: [id])

  // Balance recomputation (erd.md).
  @@index([ledgerAccountId, id])
  @@index([ledgerTransactionId])
  @@map("ledger_entry")
}

// ---------------------------------------------------------------------------
// Notifications and platform
// ---------------------------------------------------------------------------

model Notification {
  id        String               @id @default(cuid())
  userId    String
  category  NotificationCategory
  eventType NotificationEvent
  title     String
  body      String
  /// Deep-link context — entity type and id.
  payload   Json?
  readAt    DateTime?            @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user   User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  outbox NotificationOutbox[]
  emails EmailOutbox[]

  // Unread badge (erd.md).
  @@index([userId, readAt])
  @@map("notification")
}

model PushSubscription {
  id       String       @id @default(cuid())
  userId   String
  provider PushProvider

  /// Web Push. Unique when set.
  endpoint String? @unique
  p256dh   String?
  auth     String?
  /// FCM. Unique when set.
  fcmToken String? @unique

  /// "Suresh — Redmi Note 12"
  deviceLabel String?
  lastSeenAt  DateTime @db.Timestamptz(3)
  /// Set false on a 410 Gone from the push service.
  isActive    Boolean  @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user   User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  outbox NotificationOutbox[]

  @@index([userId])
  @@map("push_subscription")
}

/// US-073: a category a user has switched off. No row means on. ALERT can
/// never be off (constraints_notifications).
model NotificationPreference {
  id       String               @id @default(cuid())
  userId   String
  category NotificationCategory
  enabled  Boolean

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@map("notification_preference")
}

model NotificationOutbox {
  id                 String       @id @default(cuid())
  notificationId     String
  pushSubscriptionId String
  status             OutboxStatus @default(PENDING)
  attempts           Int          @default(0)
  lastError          String?
  /// Exponential backoff.
  nextAttemptAt      DateTime?    @db.Timestamptz(3)
  sentAt             DateTime?    @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  notification     Notification     @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  pushSubscription PushSubscription @relation(fields: [pushSubscriptionId], references: [id], onDelete: Cascade)

  @@index([notificationId])
  @@index([pushSubscriptionId])
  @@index([status, nextAttemptAt])
  @@map("notification_outbox")
}

/// Email delivery (notifications.md#email), drained by `dispatch-emails`.
/// Addressed to a user, not an address: the address is read when sending.
/// CHECKs email_outbox_attempts_non_negative_check, _sent_has_timestamp_check,
/// _failed_has_error_check, _notification_kind_check, _content_check
/// (migration constraints_email_outbox).
model EmailOutbox {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  kind           EmailKind
  /// Set exactly when kind = NOTIFICATION.
  notificationId String?
  subject        String
  textBody       String
  htmlBody       String?
  status         OutboxStatus @default(PENDING)
  attempts       Int          @default(0)
  lastError      String?
  nextAttemptAt  DateTime?    @db.Timestamptz(3)
  sentAt         DateTime?    @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  notification Notification? @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status, nextAttemptAt])
  @@index([userId])
  @@index([notificationId])
  @@map("email_outbox")
}

/// Sundays are NOT stored here — they are excluded by rule, not by data (BR-02).
model Holiday {
  id             String   @id @default(cuid())
  organizationId String
  date           DateTime @db.Date
  name           String
  /// NULL means business-wide.
  sectorId       String?

  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)
  createdByUserId String?

  organization Organization @relation(fields: [organizationId], references: [id])
  sector       Sector?      @relation(fields: [sectorId], references: [id])

  /// NULLS NOT DISTINCT (migration organization_scoped_uniques), so one
  /// business-wide (NULL sector) holiday per date per organization. Prisma
  /// cannot express the clause and does not diff it. CHECKs
  /// holiday_not_sunday_check and holiday_name_not_blank_check (migration
  /// constraints_holiday).
  @@unique([organizationId, date, sectorId])
  @@index([organizationId])
  @@index([sectorId])
  @@map("holiday")
}

/// Append-only.
model AuditLog {
  id             String      @id @default(cuid())
  /// The organization the action belongs to, so the log is read in scope
  /// (US-090). Null only for a sign-in attempt matching no staff member, and
  /// for rows written before the column existed (the table rejects UPDATE).
  organizationId String?
  /// Null for system actions.
  actorUserId    String?
  entityTable    String
  entityId       String
  action         AuditAction
  before         Json?
  after          Json?
  ipAddress      String?
  userAgent      String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  /// Restrict, not SetNull: a set-null would UPDATE audit rows, which the table rejects.
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([entityTable, entityId])
  @@index([actorUserId])
  @@index([createdAt])
  @@index([organizationId, createdAt])
  @@map("audit_log")
}

/// A security-relevant attempt the API **refused** (M13, ADR-0014).
///
/// Deliberately not `audit_log`: nothing changed, so there is no before/after
/// to snapshot and nothing that has to be immutable. The rows are telemetry
/// about people, not a record of money, and they are deletable — which is what
/// lets the RBAC matrix suite, which refuses every route for every role on
/// every run, exist at all.
model SecurityEvent {
  id             String            @id @default(cuid())
  organizationId String
  /// The signed-in staff member who made the attempt. No foreign key, like
  /// `audit_log.actorUserId`: the record must outlive the user row.
  actorUserId    String
  /// Their role at the moment of the attempt, which a later demotion must not rewrite.
  actorRole      StaffRole
  kind           SecurityEventKind
  /// The stable `AppError` code the caller was answered with.
  code           String
  /// The HTTP status the caller saw. Always a 4xx.
  /// CHECK security_event_status_refusal_check.
  status         Int
  /// CHECK security_event_method_check.
  method         String
  /// The route pattern, e.g. `/api/staff/:staffProfileId/role`.
  /// CHECK security_event_path_check.
  path           String
  /// What the attempt was aimed at, where it named something. A bare id with
  /// no table is allowed — the guard knows the id the route carried, not what
  /// kind of row it is. CHECK security_event_target_table_needs_id_check.
  targetTable    String?
  targetId       String?
  /// Curated facts only — never a request body, and never anything
  /// `SAFE_LOG_KEYS` would redact (M13).
  detail         Json?
  ipAddress      String?
  userAgent      String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  /// Cascade, unlike `audit_log`: this is operational telemetry and does not
  /// outlive the business it belongs to.
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([actorUserId])
  @@index([code])
  @@map("security_event")
}

/// The primary key is the client-supplied UUID itself, not a cuid.
model IdempotencyKey {
  key String @id

  userId         String
  /// Scopes the key to one operation.
  endpoint       String
  /// The original response, replayed verbatim on a repeat (BR-13).
  responseBody   Json
  responseStatus Int
  /// 90 days. Purged by a scheduled job.
  expiresAt      DateTime @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId])
  @@index([expiresAt])
  @@map("idempotency_key")
}

/// Runtime business settings only. Infrastructure configuration stays in
/// environment variables.
model Setting {
  id             String @id @default(cuid())
  organizationId String
  /// e.g. "collection.varianceTolerance". Unique within the organization.
  key            String
  value          Json
  description    String

  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)
  createdByUserId String?

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, key])
  @@index([organizationId])
  @@map("setting")
}
