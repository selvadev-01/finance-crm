# Rasi — environment variables
#
# Copy this file to `.env` and replace every CHANGEME. `.env` is gitignored.
# Placeholder values only in this file — never a real secret (security.md).

# --- Database --------------------------------------------------------------
# ONE PostgreSQL database, ONE schema — `public` in `rasi_dev`.
#
# `pnpm dev` and the test suite share it. Tests never truncate: service tests
# roll back, and HTTP tests delete only the rows their own run created.
DATABASE_URL="postgresql://rasi:CHANGEME@localhost:5432/rasi_dev?schema=public"

# --- Authentication --------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="CHANGEME"

# The single origin serving both the web app and the API. In development,
# Next.js proxies /api/* through to :3001 so the session cookie stays
# first-party, matching production (authentication.md).
WEB_ORIGIN="http://localhost:3000"

# --- Runtime ---------------------------------------------------------------
# apps/api validates every variable in this file at startup and refuses to
# boot, listing every problem at once, if any is missing or malformed (M16).

# development | test | production. Production additionally requires a
# BETTER_AUTH_SECRET of at least 32 characters.
NODE_ENV=development

# apps/api listens here. apps/web is fixed to 3000.
PORT=3001

# fatal | error | warn | info | debug | trace | silent. Structured JSON either
# way; the test suites force `silent` and capture logs where they assert on them.
LOG_LEVEL=info

# Optional. Identifies the deployed build in /health/info.
# BUILD_ID=

# M14 jobs (ADR-0003). true: this process also starts pg-boss, creates the
# queues and schedules, and consumes jobs. Needs the pgboss schema, created once
# by a superuser: CREATE SCHEMA pgboss AUTHORIZATION rasi;
WORKER_ENABLED=false

# Optional schedule overrides, cron in Asia/Kolkata.
# JOBS_RECONCILE_CRON=0 1 * * *
# JOBS_OVERDUE_CRON=30 0 * * *
# JOBS_PURGE_KEYS_CRON=0 2 * * *

# M10 push (notifications.md). WEB_PUSH | FCM | BOTH | NONE. NONE still writes
# every in-app notification. Generate VAPID keys once: npx web-push generate-vapid-keys
PUSH_PROVIDER=NONE
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:ops@example.com
# FCM_PROJECT_ID=
# FCM_CLIENT_EMAIL=
# FCM_PRIVATE_KEY=

# M10 email over SMTP (notifications.md#email). SMTP | NONE. NONE queues no
# email at all. With SMTP, a business owner gets a welcome email at sign-up and
# staff get every ALERT by email; `dispatch-emails` sends them, so the worker
# must run (WORKER_ENABLED=true). Any SMTP server works:
#   Mailpit on this machine  SMTP_HOST=localhost SMTP_PORT=1025, no login
#   Gmail                    smtp.gmail.com 587, SMTP_USER=you@gmail.com,
#                            SMTP_PASS=a 16-character app password
#   Amazon SES, Brevo, …     the host, port and SMTP credentials they issue
EMAIL_PROVIDER=NONE
# SMTP_HOST=
# SMTP_PORT=587
# true for port 465 (implicit TLS); false for 587 (STARTTLS).
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=Rasi <no-reply@example.com>
