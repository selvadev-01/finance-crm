# Rasi — environment variables
#
# Copy this file to `.env` and replace every CHANGEME. `.env` is gitignored.
# Placeholder values only in this file — never a real secret (security.md).

# --- Database --------------------------------------------------------------
# ONE PostgreSQL database, ONE schema — `public` in `rasi_dev`.
#
# `pnpm dev` and the test suite share it. Tests never truncate: service tests
# roll back, and HTTP tests delete only the rows their own run created.
DATABASE_URL="postgresql://rasi:CHANGEME@localhost:5432/rasi_dev?schema=public"

# --- Authentication --------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="CHANGEME"

# The single origin serving both the web app and the API. In development,
# Next.js proxies /api/* through to :3001 so the session cookie stays
# first-party, matching production (authentication.md).
WEB_ORIGIN="http://localhost:3000"

# --- Runtime ---------------------------------------------------------------
# apps/api validates every variable in this file at startup and refuses to
# boot, listing every problem at once, if any is missing or malformed (M16).

# development | test | production. Production additionally requires a
# BETTER_AUTH_SECRET of at least 32 characters.
NODE_ENV=development

# apps/api listens here. apps/web is fixed to 3000.
PORT=3001

# fatal | error | warn | info | debug | trace | silent. Structured JSON either
# way; the test suites force `silent` and capture logs where they assert on them.
LOG_LEVEL=info

# Optional. Identifies the deployed build in /health/info.
# BUILD_ID=
